{
  "name": "@mesh/cli",
  "version": "0.1.0",
  "description": "Installs the Mesh hook and MCP connection into Claude Code, Codex, Cursor and Gemini CLI",
  "type": "module",
  "bin": {
    "mesh": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@mesh/contract": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
