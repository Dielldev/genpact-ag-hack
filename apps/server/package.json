{
  "name": "@mesh/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./src/api/types.ts",
      "default": "./src/api/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\" && node --import tsx --test \"test/*.test.ts\"",
    "smoke": "tsx scripts/smoke.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "keys": "tsx scripts/keys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@mesh/contract": "workspace:*",
    "@modelcontextprotocol/sdk": "~1.31.0",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
